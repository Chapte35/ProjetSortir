{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Upload de fichier{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="card" style="background: #f8f4f0; border-radius: 15px; box-shadow: 0 6px 15px rgba(0, 0, 0, 0.08);">
            <div class="card-body">
                <div class="d-flex justify-content-center mb-4">
                    <h1 class="mb-0 position-relative" style="color: #444; padding-bottom: 12px;">
                        Upload de fichier
                        <span class="position-absolute" style="bottom: 0; left: 50%; transform: translateX(-50%); width: 100px; height: 3px; background: #96CEB4; border-radius: 3px;"></span>
                    </h1>
                </div>
                <br>

                <div class="row justify-content-center">
                    <div class="col-md-8">
                        {% if error is defined and error %}
                            <div class="alert alert-danger text-center">
                                {{ error }}
                            </div>
                        {% endif %}

                        {% if success is defined and success %}
                            <div class="alert alert-success text-center">
                                {{ success }}
                            </div>
                        {% endif %}

                        {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_widget(form) }}
                        </div>

                        <div class="d-flex justify-content-center mt-4">
                            <button type="submit" class="btn justify-content-center w-50"
                                    style="background-color: #96CEB4; color: black; font-weight: 600; border: none; padding: 10px 30px; border-radius: 8px;">
                                Enregistrer
                            </button>
                        </div>
                        {{ form_end(form) }}

                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}