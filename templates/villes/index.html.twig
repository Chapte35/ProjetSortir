{% extends 'base.html.twig' %}

{% block title %}Hello VillesController!{% endblock %}

{% block body %}

    <div class="m-5">
        <table class="table">
            <thead>
            <tr>
                <th scope="col">Ville</th>
                <th scope="col">Code Postal</th>
            </tr>
            </thead>

            <tbody>
            {% for ville in villes %}
                <tr>
                    <td>{{ ville.nom }}</td>
                    <td>{{ ville.codepostal }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>


        <span> <a type="button" class="btn btn-primary" href="{{ path('app_villesapp_villes_creer') }}">Ajouter une ville</a> </span>
    </div>
    



{% endblock %}
