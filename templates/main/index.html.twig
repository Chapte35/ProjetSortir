{% extends 'base.html.twig' %}

{% block title %}Hello MainController!{% endblock %}

{% block body %}
<style>
    .filter-card {
        background: #f8f4f0;
        border-radius: 15px;
        padding: 25px;
        margin: 20px auto;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.08);
    }

    .form-title {
        text-align: center;
        color: #444;
        margin-bottom: 25px;
        font-size: 22px;
    }

    .form-title::after {
        content: "";
        transform: translateX(-50%);
        width: 60px;
        height: 3px;
        background: #96CEB4;
        border-radius: 3px;
    }
    .form-row {
        display: flex;
        flex-wrap: wrap;
        margin: 0 -10px;
    }

    .form-column {
        flex: 1;
        padding: 0 10px;
        min-width: 300px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #555;
        font-weight: 600;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid #d1d1d1;
        border-radius: 8px;
        background-color: #fcfcfc;
        font-size: 16px;
        transition: all 0.3s;
    }

    .form-control:focus {
        border-color: #96CEB4;
        box-shadow: 0 0 5px rgba(150, 206, 180, 0.5);
        outline: none;
    }



    .btn-filter {
        background-color: #96CEB4;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px 25px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        display: block;
        width: 100%;
        margin-top: 10px;
    }

    .btn-filter:hover {
        background-color: #7fbda0;
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .form-row {
            flex-direction: column;
        }
        .form-column {
            width: 100%;
        }

        .checkbox-row {
            flex-direction: column;
            align-items: flex-start;
        }

    }
</style>
    <br>
    <h1>Sorties</h1>
    <div class="p-5">
        <div class="row">

    <div class="card container m-3 filter-card">
        <div style="
            display: flex;
            flex-direction: column;
            align-items: center;
">
            <h1 class="text-center mt-2" >Filtrer les Sorties</h1>
            <div style="width: 300px; height: 5px; background: #8bbfa7;"></div>
        </div>
        {{ form_errors(form) }}
        {{ form_start(form, {'attr': {'id': 'filter-form'}}) }}
        <div style="display: flex; flex-direction: row; width: 100%">
            <div style="width: 45vw" class="m-3 ">
                <div class="m-2">
                    {{ form_row(form.site, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="m-2 mt-1">
                    {{ form_row(form.nom) }}
                </div>

            </div>
            <div style="width: 45vw" class="m-3">

                <div class="m-2 mt-1">
                    {{ form_row(form.dateHeureDebut) }}
                </div>
                <div class="m-2 mt-1">
                    {{ form_row(form.dateHeureFin) }}
                </div>


            </div>
        </div>
        <div style="display: flex; flex-direction: row; width: 100%">
            <div class="w-50">
                <div class="m-5 w-100">
                    {{ form_row(form.moiOrganisateur) }}
                </div>
                <div class="m-5 w-100">
                    {{ form_row(form.moiInscrit) }}
                </div>
            </div>
            <div class="w-50">
                <div class="m-5 w-100">
                    {{ form_row(form.moiPasInscrit) }}
                </div>
                <div class="m-5 w-100">
                    {{ form_row(form.sortiesPassees) }}
                </div>
            </div>

        </div>
        <button type="submit" class="btn w-100 mb-3 btn-filter">Filtrer</button>
        {{ form_end(form) }}
    </div>
            <div id="sorties-container" class="container m-3 w-100 row row-cols-1 row-cols-sm-2 row-cols-md-3">
                    {% include 'main/_sorties_list.html.twig' with {'sorties': sorties} %}
            </div>
        </div>
    </div>

<script>

    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('#filter-form'); // Assurez-vous d'avoir le bon ID

        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const formData = new FormData(form);

            fetch(form.action, {
                method: form.method,
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(response => response.text())
                .then(html => {
                    document.querySelector('#sorties-container').innerHTML = html;
                })
                .catch(error => console.error('Erreur:', error));
        });
    });

</script>

{% endblock %}

