{% extends 'base.html.twig' %}

{% block title %}

{% endblock %}

{% block body %}
<div class="container">
    <h1>Mes Groupes Privés</h1>

    {% for groupe in groupes %}
    <table class="table">
        <thead>
        <tr>
            <th class="text-center fw-bold" scope="col" colspan="2">Groupe : {{ groupe.nom }}</th>
            <th class="text-center" scope="col" colspan="2">
{#                <a class="btn btn-outline-primary" href="{{ path('groupe_detail',{'id':groupe.id}) }}">Détails</a>#}
                <a class="btn btn-outline-dark" href="{{ path('groupe_modifier',{'id':groupe.id}) }}">Modifier</a>
                <a class="btn btn-outline-danger" href="{{ path('groupe_supprimer',{'id':groupe.id}) }}">Supprimer</a>
            </th>
        </tr>
        </thead>
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Pseudo</th>
                <th scope="col">Nom</th>
                <th scope="col">Prenom</th>
            </tr>
        </thead>
        <tbody>
            {% for key, membre in groupe.membres %}
                <tr>
                    <th>{{ key+1 }}</th>
                    <th scope="row">{{ membre.pseudo }}</th>
                    <td class="">{{ membre.nom }}</td>
                    <td>{{ membre.prenom }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endfor %}
</div>
{% endblock %}

