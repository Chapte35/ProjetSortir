{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="card" style="background: #f8f4f0; border-radius: 15px; box-shadow: 0 6px 15px rgba(0, 0, 0, 0.08);">
            <div class="card-body">
                <div class="d-flex justify-content-center mb-4">
                    {% if app.user %}
                        <h1 class="mb-0 position-relative" style="color: #444; padding-bottom: 12px;">
                            Modifier mon profil
                            <span class="position-absolute" style="bottom: 0; left: 50%; transform: translateX(-50%); width: 100px; height: 3px; background: #96CEB4; border-radius: 3px;"></span>
                        </h1>
                    {% endif %}
                </div>
                <span class="position-absolute" style="bottom: 0; left: 50%; transform: translateX(-50%); width: 60px; height: 3px; background: #96CEB4; border-radius: 3px;"></span>

                <br>

                <div class="row justify-content-center">
                    <div class="col-md-8">
                        {{ form_start(participantForm) }}

                        <div class="mb-3">
                            {{ form_widget(participantForm) }}
                        </div>

                        <div class="d-flex justify-content-center mt-4">
                            <button type="submit" class="btn justify-content-center w-50"
                                    style="background-color: #96CEB4; color: black; font-weight: 600; border: none; padding: 10px 30px; border-radius: 8px;">
                                Enregistrer les modifications
                            </button>
                        </div>

                        {{ form_end(participantForm) }}

                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}