{% extends 'base.html.twig' %}
{% block body %}
    <div class="container card mt-3 flex mb-3">
        <h1>Sortie</h1>

        {{ form_errors(form) }}

        {{ form_start(form) }}
        {{ form_widget(form) }}
        <div>
        <button type="submit" class="btn btn-secondary w-100 mb-3" name="action" value="enregistrer">Enregistrer</button>
        <button type="submit" class="btn btn-success w-100 mb-3" name="action" value="publier">Publier la sortie</button>
        <a type="submit" class="btn btn-warning w-100 mb-3" href="{{ path('app_main') }}">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let today = new Date().toISOString().split('T')[0] + "T00:00";


            let dateHeureDebut = document.getElementById('sorties_dateHeureDebut');
            let dateLimiteInscription = document.getElementById('sorties_dateLimiteInscription');

            if (dateHeureDebut && dateLimiteInscription) {
                dateHeureDebut.setAttribute('min', today);
                dateLimiteInscription.setAttribute('min', today);
            }
        });
    </script>

{% endblock %}
