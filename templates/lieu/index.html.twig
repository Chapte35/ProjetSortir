{% extends 'base.html.twig' %}

{% block title %}Hello LieuController!{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="card" style="background: #f8f4f0; border-radius: 15px; box-shadow: 0 6px 15px rgba(0, 0, 0, 0.08);">
        <div class="card-body">
            <div class="d-flex justify-content-center mb-4">
                <h3 class="mb-0 position-relative" style="color: #444; padding-bottom: 12px;">
                    Ajouter un Lieu
                    <span class="position-absolute"
                          style="bottom: 0; left: 50%; transform: translateX(-50%); width: 60px; height: 3px; background: #96CEB4; border-radius: 3px;"></span>
                </h3>
            </div>

            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="d-flex justify-content-center mt-3">
                <button type="submit" class="btn justify-content-center"
                        style="background-color: #96CEB4; color: white; font-weight: 600; border: none; padding: 10px 50px; border-radius: 8px;">
                    Ajouter
                </button>
            </div>
        </div>
            {{ form_end(form) }}




            {% endblock %}
