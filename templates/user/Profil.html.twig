{% extends 'base.html.twig' %}

{% block title %} {{ parent() }} | Profil{% endblock %}

{% block body %}

    <div class="container">
        <h1 class="titre-profil text-black">Bienvenue {{ pseudo }}</h1>

        <div class="profil">
            <div class="container py-3 h-100 zoom mt-10">
                <div class="row d-flex justify-content-center align-items-center">
                    <div class="col-12 col-lg-8 col-xl-6 mb-4">
                        <div class="card mb-3 " style="border-radius: .5rem;">
                            <div class="row g-0">
                                <div class="col-md-4 gradient-custom  text-center text-white"
                                     style="border-top-left-radius: .5rem; border-bottom-left-radius: .5rem;">

                                    {% if not imageSrc %}
                                        <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-chat/ava1-bg.webp"
                                             alt="Avatar" class="photo img-fluid my-4" style="width: 80px"/>
                                    {% else %}
                                        <img src="{{ asset(imageSrc) }}" alt="{{ pseudo }}" class="photo img-fluid my-4"
                                             style="width: 80px;"/>
                                    {% endif %}

                                    <h5>{{ pseudo }}</h5>
                                    <p>{{ nom }} {{ prenom }}</p>
                                    <br>
                                    {% if app.user.email == email %}
                                        <a type="button" class="btn btn-light mb-3"
                                           href="{{ path('app_user_crud_edit') }}">Modifier</a>
                                    {% endif %}
                                </div>
                                <div class="col-md-8">
                                    <div class="card-body p-3 p-md-4">
                                        <h6>Information</h6>
                                        <hr class="mt-0 mb-3">
                                        <div class="row pt-1">
                                            <div class="col-12 col-sm-6 mb-3">
                                                <h6>Email</h6>
                                                <p class="text-muted">{{ email }}</p>
                                            </div>
                                            <div class="col-12 col-sm-6 mb-3">
                                                <h6>Telephone</h6>
                                                <p class="text-muted">{{ telephone }}</p>
                                            </div>
                                        </div>
                                        <h6>Site</h6>
                                        <hr class="mt-0 mb-3">
                                        <div class="row pt-1">
                                            <div class="col-12 mb-3">
                                                <h6>Ville de rattachement</h6>
                                                <p class="text-muted">{{ site }}</p>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

